{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/agent-comment-lint-guard.sh\" codex || exit 2",
            "commandWindows": "for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @call \"%R/.codex/agent-comment-lint-guard.cmd\" codex || exit /b 2",
            "statusMessage": "Checking comments with agent-comment-lint"
          }
        ]
      }
    ]
  }
}
