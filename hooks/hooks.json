{
  "description": "Blocks a write that adds a comment breaking the agent-comment-lint rules.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-comment-lint-hook.sh\"",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
